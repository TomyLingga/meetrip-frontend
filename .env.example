# MeeTrip Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3002
NEXT_PUBLIC_PORTAL_LOGIN_URL=http://127.0.0.1:3002/login
NEXT_PUBLIC_MEETRIP_APP_ID=your_portal_meetrip_app_uuid
NEXT_PUBLIC_APP_NAME=MeeTrip
NEXT_PUBLIC_APP_DESCRIPTION=Perjalanan dinas & ruang meeting
NEXT_PUBLIC_PORTAL_NAME=InTes / Portal SSO
NEXT_PUBLIC_PORTAL_ACCOUNT_NAME=Portal INL

# Google Maps JS API key (client-side — must be HTTP-referrer restricted in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Production Render example:
# NEXT_PUBLIC_API_URL=https://meetrip-be.onrender.com
# NEXT_PUBLIC_PORTAL_URL=https://your-portal-fe.onrender.com
# NEXT_PUBLIC_PORTAL_LOGIN_URL=https://your-portal-fe.onrender.com/login
